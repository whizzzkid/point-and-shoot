---
import type { CollectionEntry } from "astro:content";

import { docsTitle, docsUrl } from "../../lib/docs.ts";

interface Props {
  currentId: string;
  entries: CollectionEntry<"docs">[];
}

const { currentId, entries } = Astro.props;
const groups = [
  {
    label: "Overview",
    entries: entries.filter((entry) => entry.id === "readme" || entry.id === "design"),
  },
  {
    label: "Specifications",
    entries: entries.filter((entry) => entry.id.startsWith("specs/")),
  },
  {
    label: "Tutorials",
    entries: entries.filter((entry) => entry.id.startsWith("tutorials/")),
  },
];
---

<aside class="docs-sidebar" transition:persist>
  <nav aria-label="Documentation navigation">
    {
      groups.map((group) => (
        <section>
          <h2>{group.label}</h2>
          <ul>
            {group.entries.map((entry) => (
              <li>
                <a
                  aria-current={entry.id === currentId ? "page" : undefined}
                  href={docsUrl(entry.id)}
                >
                  {docsTitle(entry.body, entry.id)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </nav>
</aside>

<script is:inline>
  (() => {
    if (window.__docsSidebarSwapWired) return;
    window.__docsSidebarSwapWired = true;
    document.addEventListener("astro:after-swap", () => {
      const sidebar = document.querySelector(".docs-sidebar");
      if (!sidebar) return;
      const path = location.pathname.replace(/\/$/, "") || "/";
      const links = sidebar.querySelectorAll("a[href]");
      for (let i = 0; i < links.length; i++) {
        const href = (links[i].getAttribute("href") || "").replace(/\/$/, "") || "/";
        if (href === path) {
          links[i].setAttribute("aria-current", "page");
        } else {
          links[i].removeAttribute("aria-current");
        }
      }
    });
  })();
</script>
