---
import storeListing from "../../.generated/store-listing.json";
import { createInstallActionsModel } from "../lib/install-actions.mjs";
import SiteIcon from "./SiteIcon.astro";

interface Props {
  enhance?: boolean;
  variant: "closing" | "hero";
}

const { enhance = false, variant } = Astro.props;
const install = createInstallActionsModel(storeListing);
---

<section class:list={["install-actions", `install-actions--${variant}`]} data-install-actions>
  <div class="install-options" data-install-options>
    {
      install.actions.map((action) => (
        <div class="install-store" data-install-store>
          <p class="install-store-copy">
            Open the browser-extension listing to install Point & Shoot. {install.singlePurpose}
          </p>
          <a
            class="store-badge-link"
            data-install-target={action.target}
            data-store-action={action.target}
            href={action.url}
          >
            <img
              class="store-badge"
              src={action.badgePath}
              alt={`Install Point & Shoot from ${action.name}`}
              height="48"
            />
          </a>
        </div>
      ))
    }
    <div class="install-source">
      <p class="install-source-copy">Build Point & Shoot locally from the repository source.</p>
      <a
        class="button button-github"
        data-source-install
        href={install.sourceInstallUrl}
      >
        <SiteIcon name="github" />
        Build from source
      </a>
    </div>
  </div>
  <p class="install-status" data-install-status>
    {
      install.statuses.length > 0
        ? install.statuses.join(" ")
        : "Choose the compatible desktop browser store or build from source."
    }
  </p>
  {
    enhance && (
      <p
        class="install-recommendation"
        data-install-recommendation
        role="status"
        aria-live="polite"
      />
    )
  }
  <noscript>
    <p class="install-no-script" data-no-script>
      JavaScript is not required. Choose a published browser-extension listing or build from source.
    </p>
  </noscript>
</section>

{
  enhance && (
    <script>
      import {enhanceInstallActions} from "../lib/install-recommendation";
      enhanceInstallActions(document);
    </script>
  )
}
