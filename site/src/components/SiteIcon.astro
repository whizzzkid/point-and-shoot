---
/**
 * Site-chrome icons, inlined per component instead of read from `/brand/icons.svg`.
 *
 * That sprite is generated by `build/vendor-assets.ts` from the icon names the *extension* surfaces
 * reference, and it ships inside both browser packages. Header chrome is site-only, so adding these
 * names there would grow the shipped extension payload for markup no extension surface renders.
 * Geometry sits on the same 24px grid and 1.5 stroke as the vendored sprite so the two sets read as
 * one system: `book-open`, `chevron-left`, `chevron-right`, `house`, `moon`, `shield-check`, `star`,
 * and `sun` are Lucide (ISC); `github` is the GitHub mark, which Lucide does not ship.
 *
 * Nothing here is remote and nothing is fetched at runtime, so ADR-0009 still holds.
 */
type IconName =
  | "book-open"
  | "chevron-left"
  | "chevron-right"
  | "github"
  | "house"
  | "moon"
  | "shield-check"
  | "star"
  | "sun";

interface Props {
  name: IconName;
}

/**
 * `paint: "fill"` marks the solid brand mark; every other icon is an outline drawn with the shared
 * stroke attributes. Bodies are the inner markup only — the wrapper supplies the rest.
 */
const ICONS: Record<IconName, { body: string; paint: "fill" | "stroke" }> = {
  "book-open": {
    body:
      '<path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />',
    paint: "stroke",
  },
  "chevron-left": {
    body: '<path d="m15 18-6-6 6-6" />',
    paint: "stroke",
  },
  "chevron-right": {
    body: '<path d="m9 18 6-6-6-6" />',
    paint: "stroke",
  },
  github: {
    body:
      '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />',
    paint: "fill",
  },
  house: {
    body:
      '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" /><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />',
    paint: "stroke",
  },
  moon: {
    body:
      '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />',
    paint: "stroke",
  },
  "shield-check": {
    body:
      '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />',
    paint: "stroke",
  },
  star: {
    body:
      '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.634-2.428a2.122 2.122 0 0 0-1.973 0L6.363 21.11a.53.53 0 0 1-.771-.56l.882-5.139a2.122 2.122 0 0 0-.611-1.879L2.127 9.895a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />',
    paint: "stroke",
  },
  sun: {
    body:
      '<circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />',
    paint: "stroke",
  },
};

const { name } = Astro.props;
const icon = ICONS[name];
if (!icon) throw new Error(`SiteIcon: unknown icon name "${name}"`);
---

<!-- `set:html` renders a fixed local constant selected by a closed union; no caller input reaches it. -->
<svg
  class="site-icon"
  viewBox="0 0 24 24"
  fill={icon.paint === "fill" ? "currentColor" : "none"}
  stroke={icon.paint === "stroke" ? "currentColor" : "none"}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon.body}
/>

<style>
  .site-icon {
    flex: none;
    width: var(--space-4);
    height: var(--space-4);
  }
</style>
