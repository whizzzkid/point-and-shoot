---
import Icon from "../components/Icon.astro";
import InstallActions from "../components/InstallActions.astro";
import SiteIcon from "../components/SiteIcon.astro";
import ThemeScript from "../components/ThemeScript.astro";
import storeListing from "../../.generated/store-listing.json";
import "../styles/global.css";

const repositoryUrl = "https://github.com/whizzzkid/point-and-shoot";
const { support } = storeListing;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Highlight UI bugs, capture the evidence, and hand an agent the context to fix them."
    />
    <link rel="icon" href="/brand/icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>Point & Shoot — UI bug reports built for coding agents</title>
    <ThemeScript />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Point & Shoot home">
        <img src="/brand/icon.svg" alt="" width="48" height="48" />
        <span>Point & Shoot</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#workflow">
          <Icon name="arrow-down" />
          <span>How it works</span>
        </a>
        <a href="/docs/">
          <SiteIcon name="book-open" />
          <span>Docs</span>
        </a>
        <a href={repositoryUrl}>
          <SiteIcon name="github" />
          <span>GitHub</span>
        </a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Evidence for coding agents</p>
          <h1 id="hero-title">Point. Shoot. Fix.</h1>
          <p class="hero-intro">
            Highlight what is broken on any page, leave a note, and export the screenshot,
            selectors, styles, and page context your coding agent needs to act.
          </p>
          <InstallActions variant="hero" enhance />
          <a class="button button-secondary hero-workflow-link" href="#workflow">See how it works</a
          >
        </div>

        <div class="product-frame" aria-label="Point & Shoot notes panel preview">
          <div class="browser-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <code>localhost:4321/dashboard</code>
          </div>
          <div class="product-stage">
            <div class="capture-outline" aria-hidden="true">
              <span>button.primary-action</span>
            </div>
            <img
              src="/product/notes-panel.png"
              alt="The Point & Shoot notes panel showing captured UI feedback"
              width="1100"
              height="820"
            />
          </div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Product qualities">
        <p><strong>Chrome and Firefox</strong><span>One cross-browser codebase</span></p>
        <p><strong>Active tab only</strong><span>Access starts with your gesture</span></p>
        <p>
          <strong>Agent-ready export</strong><span>Structured evidence, not a vague ticket</span>
        </p>
      </section>

      <section class="workflow section" id="workflow" aria-labelledby="workflow-title">
        <div class="section-heading">
          <p class="eyebrow">A tighter feedback loop</p>
          <h2 id="workflow-title">From broken pixel to actionable context</h2>
          <p>Capture what you see without stopping to reconstruct it in another tool.</p>
        </div>
        <ol class="workflow-grid">
          <li>
            <span class="step-icon"><Icon name="crosshair" /></span>
            <p class="step-number">01</p>
            <h3>Highlight anything</h3>
            <p>Select an element or drag around a region on the page you are already testing.</p>
          </li>
          <li>
            <span class="step-icon"><Icon name="camera" /></span>
            <p class="step-number">02</p>
            <h3>Capture the evidence</h3>
            <p>
              Keep the screenshot, URL, selector fallbacks, DOM text, and computed styles together.
            </p>
          </li>
          <li>
            <span class="step-icon"><Icon name="list-checks" /></span>
            <p class="step-number">03</p>
            <h3>Review the session</h3>
            <p>Edit, reorder, or exclude notes before anything leaves your browser.</p>
          </li>
          <li>
            <span class="step-icon"><Icon name="arrow-up" /></span>
            <p class="step-number">04</p>
            <h3>Hand it to an agent</h3>
            <p>Export a structured bundle with a readable plan and the canonical session record.</p>
          </li>
        </ol>
      </section>

      <section class="evidence section" aria-labelledby="evidence-title">
        <div>
          <p class="eyebrow">Built for the fix</p>
          <h2 id="evidence-title">The details that survive handoff</h2>
          <p>
            A screenshot explains the symptom. Point & Shoot also preserves enough page evidence for
            an agent to find the right code and verify the result.
          </p>
        </div>
        <dl>
          <div><dt>Visual</dt><dd>Clamped WebP region capture</dd></div>
          <div><dt>Location</dt><dd>Page URL with privacy controls</dd></div>
          <div><dt>Identity</dt><dd>Test id, ARIA, CSS, and XPath fallbacks</dd></div>
          <div><dt>Context</dt><dd>DOM text, metadata, and computed-style digest</dd></div>
          <div><dt>Output</dt><dd>Canonical JSON, readable plan, and screenshots</dd></div>
        </dl>
      </section>

      <section class="closing section" aria-labelledby="closing-title">
        <img src="/brand/icon.svg" alt="" width="48" height="48" />
        <h2 id="closing-title">Make the bug report part of the fix.</h2>
        <p>Install the current build locally, or explore the capture model first.</p>
        <InstallActions variant="closing" />
        <a class="button button-secondary closing-docs-link" href="/docs/">Read the documentation</a
        >
      </section>
    </main>

    <footer>
      <a class="brand" href="/">
        <img src="/brand/icon.svg" alt="" width="48" height="48" />
        <span>Point & Shoot</span>
      </a>
      <p>UI evidence for coding agents.</p>
      <div>
        <a href="/docs/">Docs</a>
        <a href="/privacy/">Privacy</a>
        <a href={`mailto:${support.email}`}>Support</a>
        <a href={repositoryUrl}>GitHub</a>
      </div>
      <p class="footer-copyright">&copy; <a href="https://whizzzkid.dev">Whizzzkid Inc.</a></p>
    </footer>
  </body>
</html>
