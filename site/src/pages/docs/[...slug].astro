---
import { getCollection, render, type CollectionEntry } from "astro:content";

import DocsLayout from "../../layouts/DocsLayout.astro";
import { docsRoute, docsTitle, sortDocs } from "../../lib/docs.ts";

interface Props {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
}

export async function getStaticPaths() {
  const entries = sortDocs(await getCollection("docs"));
  return entries.map((entry) => ({
    params: { slug: docsRoute(entry.id) || undefined },
    props: { entries, entry },
  }));
}

const { entries, entry } = Astro.props;
const { Content } = await render(entry);
const title = docsTitle(entry.body, entry.id);

const sortedEntries = sortDocs(entries);
const currentIndex = sortedEntries.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? sortedEntries[currentIndex - 1] : undefined;
const nextEntry = currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : undefined;
---

<DocsLayout currentId={entry.id} entries={entries} title={title} prevEntry={prevEntry} nextEntry={nextEntry}>
  <article>
    <Content />
  </article>
</DocsLayout>
