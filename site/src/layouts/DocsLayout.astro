---
import type { CollectionEntry } from "astro:content";

import DocsSidebar from "../components/docs/DocsSidebar.astro";
import SiteIcon from "../components/SiteIcon.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import repository from "../../.generated/repository.json";
import { formatStarCount } from "../lib/star-count.mjs";
import { docsTitle, docsUrl } from "../lib/docs.ts";
import "../styles/docs.css";

interface Props {
  currentId: string;
  entries: CollectionEntry<"docs">[];
  title: string;
  prevEntry?: CollectionEntry<"docs">;
  nextEntry?: CollectionEntry<"docs">;
}

const { currentId, entries, title } = Astro.props;
const canonicalPath = Astro.url.pathname;
const docsIndexPath = "/docs/";
const privacyPath = "/privacy/";
// `null` whenever the build could not establish a count, in which case the repository link renders
// without a badge rather than showing a placeholder that claims something untrue.
const starLabel = formatStarCount(repository.stars);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${title} — Point & Shoot product documentation.`} />
    <link rel="icon" href="/brand/icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title} — Point & Shoot docs</title>
    <ThemeScript />
  </head>
  <body>
    <a class="skip-link" href="#docs-content">Skip to content</a>
    <header class="docs-header">
      <a class="docs-brand" href="/" aria-label="Point & Shoot home">
        <img src="/brand/icon.svg" alt="" width="48" height="48" />
        <span>Point & Shoot</span>
      </a>
      <div class="docs-header-actions">
        <nav aria-label="Site navigation">
          <a
            href={docsIndexPath}
            aria-current={canonicalPath === docsIndexPath ? "page" : undefined}
          >
            <SiteIcon name="book-open" />
            <span class="docs-nav-label">Docs</span>
          </a>
          <a href={privacyPath}>
            <SiteIcon name="shield-check" />
            <span class="docs-nav-label">Privacy</span>
          </a>
          <a href={repository.url}>
            <SiteIcon name="github" />
            <span class="docs-nav-label">GitHub</span>
            {
              starLabel !== null && (
                <span class="docs-star-count">
                  <SiteIcon name="star" />
                  <span>{starLabel}</span>
                  <span class="visually-hidden">stars</span>
                </span>
              )
            }
          </a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <div class="docs-shell">
      <DocsSidebar currentId={currentId} entries={entries} />
      <main class="docs-content" id="docs-content">
        <slot />
        <footer>
          <nav class="docs-nav" aria-label="Documentation pagination">
            {prevEntry && (
              <a class="docs-nav-link docs-nav-prev" href={docsUrl(prevEntry.id)}>
                <SiteIcon name="chevron-left" />
                <span>
                  <span class="docs-nav-label">Previous</span>
                  <span class="docs-nav-title">{docsTitle(prevEntry.body, prevEntry.id)}</span>
                </span>
              </a>
            )}
            {nextEntry && (
              <a class="docs-nav-link docs-nav-next" href={docsUrl(nextEntry.id)}>
                <span>
                  <span class="docs-nav-label">Next</span>
                  <span class="docs-nav-title">{docsTitle(nextEntry.body, nextEntry.id)}</span>
                </span>
                <SiteIcon name="chevron-right" />
              </a>
            )}
          </nav>
          <div class="docs-footer">
            <p>Point & Shoot product documentation.</p>
            <a href="https://github.com/whizzzkid/point-and-shoot/tree/main/docs">
              Read the source on GitHub
            </a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>
