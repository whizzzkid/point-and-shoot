{
  "name": "point-and-shoot-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "build": "node scripts/run-astro.mjs build",
    "check": "node scripts/run-astro.mjs check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test scripts/*.test.mjs",
    "links": "node scripts/check-links.mjs --external",
    "links:internal": "node scripts/check-links.mjs",
    "preview": "node scripts/serve-built.mjs",
    "a11y": "node scripts/check-a11y.mjs",
    "lighthouse": "node scripts/check-lighthouse.mjs",
    "ci": "npm run lint && npm run check && npm run test && npm run build && npm run links"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "astro": "7.1.6",
    "beautiful-mermaid": "1.1.3",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "parse5": "8.0.1",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
