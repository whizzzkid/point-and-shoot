{
  // `.claude-design/` is an upstream design-system artifact, excluded from every
  // subcommand: reformatting it manufactures a diff in something this repo does not
  // own, local edits are silently lost on the next export, and its .jsx/.d.ts files
  // import `react` — a dependency this project deliberately does not have, so
  // `deno check` fails on them. See docs/design.md.
  "exclude": [".claude-design/"],
  "lint": {
    "include": ["src/", "tests/", "build/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-slow-types"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "useTabs": false
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  // Wave 2+ adds the pinned npm specifiers here: esbuild@0.28.1,
  // playwright@1.62.0, web-ext@10.5.0, and preact (version resolved in wave 2).
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  // `ci` is the one command both GitHub Actions and the lefthook pre-push gate
  // call, so local and remote cannot diverge. Tasks for build, e2e,
  // smoke:firefox, fixture, and shots land with the items that implement them —
  // a stubbed task that silently passes is worse than a missing one.
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check",
    "test": "deno test -A",
    "fixture": "deno run -A tests/fixtures/app/server.ts",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  }
}
