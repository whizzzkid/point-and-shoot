{
  // `.claude-design/` is an upstream design-system artifact, excluded from every
  // subcommand: reformatting it manufactures a diff in something this repo does not
  // own, local edits are silently lost on the next export, and its .jsx/.d.ts files
  // import `react` — a dependency this project deliberately does not have, so
  // `deno check` fails on them. See docs/design.md.
  //
  // `.review-playground/` holds gitignored review scratch — deliberately broken
  // copies of real modules. Without this, `deno check` and `deno test` discover it
  // and the authoritative gate fails on files that exist to fail. React and Vue are pinned only
  // for W3.11's real development-build framework fixtures; extension surfaces still use Preact.
  "exclude": [".claude-design/", ".review-playground/"],
  "lint": {
    "include": ["src/", "tests/", "build/", "scripts/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-slow-types"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "useTabs": false
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  // Every dependency is pinned here and nowhere else, so a version lives in one
  // place and source files import a bare name. `esbuild` and `web-ext` are
  // build-time-only CLIs, pinned inline at their npm: import site instead (see
  // build/build.ts), matching the existing subset-font/oxlint convention.
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/path": "jsr:@std/path@1.1.6",
    "@types/pngjs": "npm:@types/pngjs@6.0.5",
    "pixelmatch": "npm:pixelmatch@7.2.0",
    "playwright": "npm:playwright@1.62.0",
    "pngjs": "npm:pngjs@7.0.0",
    "fake-indexeddb": "npm:fake-indexeddb@6.2.5",
    "preact": "npm:preact@10.29.7",
    "react": "npm:react@18.3.1",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "scheduler": "npm:scheduler@0.23.2",
    "loose-envify": "npm:loose-envify@1.4.0",
    "vue": "npm:vue@3.5.40/dist/vue.esm-browser.js"
  },
  // `ci` is the one command both GitHub Actions and the lefthook pre-push gate
  // call, so local and remote cannot diverge. Tasks for e2e and smoke:firefox
  // land with the items that implement them — a stubbed task that silently
  // passes is worse than a missing one.
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check",
    "test": "deno test -A",
    "fixture": "deno run -A tests/fixtures/app/server.ts",
    "shots": "deno run -A tests/shots.ts",
    "shots:wave3": "deno task build && deno run -A tests/wave-3-shots.ts",
    "tokens": "deno run -A build/tokens.ts",
    "tokens:check": "deno run -A build/tokens.ts --check",
    "lint:design": "deno run -A build/lint-design.ts",
    "build": "deno run -A build/build.ts",
    "build:release": "deno run -A build/build.ts --release",
    "lint:firefox": "deno run -A npm:web-ext@10.5.0 lint --source-dir dist/firefox",
    "e2e:smoke": "deno task build && deno test -A tests/e2e/load.spec.ts",
    "e2e:session": "deno task build && deno test -A tests/e2e/session-action.spec.ts",
    "e2e:full": "deno task build && deno test -A tests/e2e/full-flow.spec.ts",
    "visual": "deno task build && deno run -A tests/visual/run.ts",
    "visual:update": "deno task build && deno run -A tests/visual/run.ts --update",
    "boot:firefox": "deno run -A scripts/boot-firefox.ts",
    "gallery": "deno run -A src/ui/gallery/server.ts",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  }
}
