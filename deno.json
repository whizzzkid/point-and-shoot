{
  // `.claude-design/` is an upstream design-system artifact, excluded from every
  // subcommand: reformatting it manufactures a diff in something this repo does not
  // own, local edits are silently lost on the next export, and its .jsx/.d.ts files
  // import `react` — a dependency this project deliberately does not have, so
  // `deno check` fails on them. See docs/design.md.
  //
  // `.review-playground/` holds gitignored review scratch — deliberately broken
  // copies of real modules. Without this, `deno check` and `deno test` discover it
  // and the authoritative gate fails on files that exist to fail. React and Vue are pinned only
  // for real development-build framework fixtures; extension surfaces still use Preact.
  "exclude": [
    ".claude-design/",
    ".review-playground/",
    "site/.astro/",
    "site/.generated/",
    "site/.lighthouse/",
    "site/dist/"
  ],
  // Astro and its Vite-based dependencies resolve through a generated, gitignored node_modules
  // tree. Deno owns and populates that compatibility tree; npm and Node are not project tools.
  "nodeModulesDir": "auto",
  "lint": {
    "include": ["src/", "tests/", "build/", "scripts/"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-slow-types"]
    }
  },
  "fmt": {
    // Release Please owns CHANGELOG.md and rewrites it on every release pull request. Preserve
    // its deterministic output instead of making generated PRs reformat the same content.
    "exclude": ["CHANGELOG.md"],
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "useTabs": false
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  // Every direct dependency is pinned here, so source files import a bare name.
  // CLI entry points repeat their exact npm: version at invocation because Deno
  // runs the package executable rather than a library export.
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@0.9.10",
    "@astrojs/markdown-remark": "npm:@astrojs/markdown-remark@7.2.2",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "@std/path": "jsr:@std/path@1.1.6",
    "@types/pngjs": "npm:@types/pngjs@6.0.5",
    "@axe-core/playwright": "npm:@axe-core/playwright@4.12.1",
    "astro": "npm:astro@7.1.6",
    "axe-core": "npm:axe-core@4.12.1",
    "beautiful-mermaid": "npm:beautiful-mermaid@1.1.3",
    "chrome-launcher": "npm:chrome-launcher@1.2.1",
    "lighthouse": "npm:lighthouse@13.4.1",
    "parse5": "npm:parse5@8.0.1",
    "pixelmatch": "npm:pixelmatch@7.2.0",
    "playwright": "npm:playwright@1.62.0",
    "pngjs": "npm:pngjs@7.0.0",
    "fake-indexeddb": "npm:fake-indexeddb@6.2.5",
    "preact": "npm:preact@10.29.7",
    "react": "npm:react@18.3.1",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "rehype-autolink-headings": "npm:rehype-autolink-headings@7.1.0",
    "rehype-slug": "npm:rehype-slug@6.0.0",
    "scheduler": "npm:scheduler@0.23.2",
    "loose-envify": "npm:loose-envify@1.4.0",
    "typescript": "npm:typescript@6.0.3",
    "unist-util-visit": "npm:unist-util-visit@5.1.0",
    "vue": "npm:vue@3.5.40/dist/vue.esm-browser.js"
  },
  // `ci` is the one command both GitHub Actions and the lefthook pre-push gate
  // call, so local and remote cannot diverge. Tasks for e2e and smoke:firefox
  // land with the items that implement them — a stubbed task that silently
  // passes is worse than a missing one.
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check",
    "test": "deno test -A",
    "fixture": "deno run -A tests/fixtures/app/server.ts",
    "shots": "deno run -A tests/shots.ts",
    "shots:wave3": "deno task build && deno run -A tests/wave-3-shots.ts",
    "tokens": "deno run -A build/tokens.ts",
    "tokens:check": "deno run -A build/tokens.ts --check",
    "lint:design": "deno run -A build/lint-design.ts",
    "build": "deno run -A build/build.ts",
    "build:release": "deno run -A build/build.ts --release",
    "release:artifacts": "deno task build:release && deno task release:reviewer-source",
    "release:reviewer-source": "deno run -A build/reviewer-source.ts create",
    "release:compare": "deno run -A build/reviewer-source.ts compare",
    "release:current": "deno run -A build/release.ts current",
    "release:next": "deno run -A build/release.ts next",
    "release:pr": "deno run -A npm:release-please@17.6.0 release-pr",
    "release:status": "deno run -A build/release-status.ts",
    "release:validate": "deno run -A build/release.ts validate",
    "store:check": "deno run -A build/store-listing.ts check",
    "store:sync": "deno run -A build/store-listing.ts sync",
    "store:assets": "deno task build:release && deno run -A build/store-assets.ts generate",
    "store:assets:refresh-badges": "deno run -A build/store-assets.ts refresh-badges",
    "store:assets:check": "deno run -A build/store-assets.ts check",
    "store:release": "deno run -A scripts/store-release.ts",
    "lint:firefox": "deno run -A npm:web-ext@10.5.0 lint --source-dir dist/firefox",
    "e2e:smoke": "deno task build && deno test -A tests/e2e/load.spec.ts",
    "e2e:session": "deno task build && deno test -A tests/e2e/session-action.spec.ts",
    "e2e:full": "deno task build && deno test -A tests/e2e/full-flow.spec.ts",
    "visual": "deno task build && deno run -A tests/visual/run.ts",
    "visual:update": "deno task build && deno run -A tests/visual/run.ts --update",
    "visual:commit": "deno run --allow-run=git --allow-read --allow-env --allow-net=api.github.com scripts/ci-commit-verified.ts tests/visual/baselines",
    "boot:firefox": "deno run -A scripts/boot-firefox.ts",
    "smoke:firefox": "deno task build && deno run -A tests/firefox/smoke.ts",
    "a11y": "deno task build && deno test -A tests/a11y/*.test.ts tests/a11y/*.spec.ts",
    "gallery": "deno run -A src/ui/gallery/server.ts",
    "playwright:install": "deno run -A npm:playwright@1.62.0 install",
    "site:dev": "deno run -A site/scripts/run-astro.mjs dev",
    "site:build": "deno run -A site/scripts/run-astro.mjs build",
    "site:check": "deno run -A site/scripts/run-astro.mjs check",
    "site:fmt": "deno fmt site",
    "site:lint": "deno fmt --check site && deno lint site",
    "site:test": "deno test -A site/",
    "site:links": "deno run -A site/scripts/check-links.mjs --external",
    "site:links:internal": "deno run -A site/scripts/check-links.mjs",
    "site:preview": "deno run -A site/scripts/serve-built.mjs",
    "site:a11y": "deno run -A site/scripts/check-a11y.mjs",
    "site:lighthouse": "deno run -A site/scripts/check-lighthouse.mjs",
    "site:ci": "deno task site:lint && deno task site:check && deno task site:test && deno task site:build && deno task site:links",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task store:check && deno task store:assets:check && deno task test"
  }
}
