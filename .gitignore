# Deno
# https://deno.com/

# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

# Agent scratch output — never part of the repo
.playwright-mcp/
.remember/
.review-playground/

# Build output — generated by `deno task build`, never committed
dist/

# Node-ecosystem tooling reached through `npm:` specifiers. There is no
# root package.json, but Playwright, esbuild and web-ext still write here.
node_modules/
.playwright/
playwright-report/

# The Astro site owns an isolated Node toolchain. Its generated design bridge is
# ephemeral: committed design tokens and fonts remain under src/shared/design/.
site/.astro/
site/.generated/
site/.lighthouse/

# Extension packages produced by web-ext release tooling
web-ext-artifacts/
*.zip

# macOS
.DS_Store
