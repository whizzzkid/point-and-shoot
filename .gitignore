# Deno
# https://deno.com/

# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

# Agent scratch output — never part of the repo
.playwright-mcp/
.remember/
.review-playground/

# Build output — generated by `deno task build`, never committed
dist/

# Deno generates this compatibility tree for npm packages that require Node-style
# resolution. It is not a separately managed Node project.
node_modules/
.playwright/
playwright-report/

# The Deno-owned Astro tasks generate this site state. Committed design tokens and
# fonts remain under src/shared/design/.
site/.astro/
site/.generated/
site/.lighthouse/

# Extension packages produced by web-ext release tooling
web-ext-artifacts/
*.zip

# macOS
.DS_Store
